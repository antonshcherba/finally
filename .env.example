# Required for chat: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (formerly Polygon.io) API key for real market data.
# Needs a Stocks Starter plan or above (snapshots are not on the free plan);
# a rejected key falls back to the built-in simulator.
# If not set, the built-in market simulator is used (recommended for most users)
MASSIVE_API_KEY=

# Optional: seconds between Massive polls (default 15; paid tiers: 2-5)
MASSIVE_POLL_INTERVAL=15

# Optional: Set to "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false
